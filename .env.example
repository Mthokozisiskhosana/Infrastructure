# Copy this file to .env and fill in your own values. Never commit .env.

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ciris
DB_USER=postgres
DB_PASSWORD=
# Set to false for a local Postgres without SSL
DB_SSL=false
# Alternatively, a single connection string (e.g. Render): DATABASE_URL=

# --- JWT --- (any long random string)
JWT_SECRET=

# --- SMTP (password-reset codes, staff invites, security emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CIRIS Community Portal <your-address@gmail.com>"

# --- App ---
APP_URL=http://localhost:3000
# Hours before a resolved report moves to History (default 24)
ARCHIVE_DELAY_HOURS=24

# --- AI Service (ciris-ai-service, run with: uvicorn main:app --port 8000) ---
AI_SERVICE_URL=http://localhost:8000
