# Copy this file to .env and fill in your own values. Never commit .env.

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ciris
DB_USER=postgres
DB_PASSWORD=
# Set to false for a local Postgres without SSL
DB_SSL=false
# Alternatively, a single connection string (e.g. Render): DATABASE_URL=

# --- JWT --- (any long random string)
JWT_SECRET=

# --- SMTP (password-reset codes, staff invites, security emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CIRIS Community Portal <your-address@gmail.com>"

# --- Email via Brevo (optional — recommended when deployed) ---
# When BREVO_API_KEY is set, emails go through Brevo's web API instead of
# SMTP (free hosting plans often block SMTP ports). Free: 300 emails/day.
# Brevo -> SMTP & API -> API Keys. The sender must be verified in Brevo -> Senders.
BREVO_API_KEY=
BREVO_SENDER="CIRIS Community Portal <your-address@gmail.com>"

# --- App ---
APP_URL=http://localhost:3000
# Hours before a resolved report moves to History (default 24)
ARCHIVE_DELAY_HOURS=24

# --- Photo storage (optional) ---
# Leave empty to store photos in ./uploads on this computer.
# Set both (e.g. on Render) to store them in Supabase Storage instead:
# Supabase dashboard -> Project Settings -> API Keys -> "secret" (or legacy service_role) key
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=ciris-uploads

# --- AI Service (ciris-ai-service, run with: uvicorn main:app --port 8000) ---
AI_SERVICE_URL=http://localhost:8000
